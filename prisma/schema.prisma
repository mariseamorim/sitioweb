// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Farm {
  id             String   @id @default(cuid())
  name           String
  propertyType   String?  @default("Fazenda")
  documentType   String?
  documentNumber String?  @unique
  owner          String?
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  isActive       Boolean  @default(true)
  milkPrice      Float? // valor do litro de leite (estimativa de quanto vai receber)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  animals         Animal[]
  users           User[]
  reproductions   Reproduction[]
  transactions    Transaction[]
  supplies        Supply[]
  milkProductions MilkProduction[]
  vendorClients   VendorClient[]
  milkPoints      MilkPoint[] // sítios de rota de motoristas ligados a esta propriedade
  supplyRequests  SupplyRequest[]
  orgMemberships  OrgMember[] // associações de que a propriedade participa
  milkSheets      MilkSheet[] // litros da folha do motorista, para conferir

  @@map("farms")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  password     String?
  googleId     String?     @unique
  role         String      @default("viewer")
  permissions  Json? // String[] de chaves de módulo; null = admin tem tudo
  farmId       String?
  farm         Farm?       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  vendorId     String? // preenchido quando role = "fornecedor"
  vendor       Vendor?     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  offersSeenAt DateTime? // última vez que o produtor abriu a tela de ofertas
  milkPrice    Float? // Anota Aí Leite: valor do litro informado pelo produtor
  milkPoints   MilkPoint[]
  /// Laticínio/associação: quem administra (role laticinio/associacao) ou motorista do laticínio
  organizationId String?
  organization   Organization? @relation("OrgUsers", fields: [organizationId], references: [id], onDelete: SetNull)
  phone          String? // contato (motorista do laticínio)
  vehicle        String? // veículo do motorista do laticínio
  driverRoutes     Route[]        @relation("RouteDriver")
  collectedEntries MilkEntry[]    @relation("EntryCollector")
  orgMemberships   OrgMember[] // associações do produtor do Anota Aí Leite (sem propriedade)
  milkSheets       MilkSheet[] // litros da folha do motorista, para conferir
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([organizationId])
  @@map("users")
}

model Animal {
  id           String    @id @default(cuid())
  code         String // número automático da propriedade (01, 02...)
  customCode   String? // outro código opcional do produtor: brinco, SISBOV...
  name         String
  species      String
  gender       String
  birthDate    DateTime
  isCastrated  Boolean   @default(false)
  acquisitionType String @default("existente") // existente | nascimento | compra
  status       String
  gta          String?
  observations String?
  imageUrl     String?
  lowDate      DateTime?
  lowReason    String?
  farmId       String
  farm         Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  // Mãe (para crias): cada vaca guarda a lista das suas crias
  motherId     String?
  mother       Animal?   @relation("Crias", fields: [motherId], references: [id], onDelete: SetNull)
  calves       Animal[]  @relation("Crias")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  milkProductions      MilkProduction[]
  veterinaryTreatments VeterinaryTreatment[]
  vaccinations         Vaccination[]
  reproductions        Reproduction[]        @relation("ReproductionFemale")
  transactions         Transaction[]

  @@unique([farmId, code])
  @@unique([farmId, customCode])
  @@index([motherId])
  @@map("animals")
}

model AnimalHistory {
  id         String   @id @default(cuid())
  animalCode String
  animalName String
  action     String
  changes    String?
  userId     String?
  createdAt  DateTime @default(now())

  @@map("animal_histories")
}

model MilkProduction {
  id           String   @id @default(cuid())
  farmId       String
  farm         Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animalId     String? // vazio = total do dia, sem separar por vaca
  animal       Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  date         DateTime
  quantity     Float
  pricePerLiter Float? // preço do litro no momento do lançamento, preserva o histórico
  cowsMilked   Int? // no total do dia: quantas vacas foram ordenhadas
  source       String? // "lite" = anotado pelo Anota Aí Leite (um por dia); vazio = app completo
  observations String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([farmId, date])
  @@map("milk_productions")
}

model VeterinaryTreatment {
  id           String    @id @default(cuid())
  animalId     String
  animal       Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime?
  medicine     String
  batch        String?
  manufacturer String?
  description  String?
  observations String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("veterinary_treatments")
}

model Vaccination {
  id            String    @id @default(cuid())
  animalId      String
  animal        Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  vaccineName   String
  scheduledDate DateTime
  appliedDate   DateTime?
  batch         String?
  manufacturer  String?
  observations  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("vaccinations")
}

model Reproduction {
  id                String    @id @default(cuid())
  femaleId          String
  female            Animal    @relation("ReproductionFemale", fields: [femaleId], references: [id], onDelete: Cascade)
  maleName          String?
  coverageDate      DateTime
  expectedBirthDate DateTime?
  actualBirthDate   DateTime?
  status            String    @default("Coberta")
  calfId            String?
  observations      String?
  farmId            String
  farm              Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("reproductions")
}

model Transaction {
  id          String   @id @default(cuid())
  type        String
  category    String
  date        DateTime
  amount      Float
  description String?
  animalId    String?
  animal      Animal?  @relation(fields: [animalId], references: [id])
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("transactions")
}

model Supply {
  id              String           @id @default(cuid())
  name            String
  category        String
  unit            String
  currentQuantity Float            @default(0)
  minimumQuantity Float            @default(0)
  farmId          String
  farm            Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  movements       SupplyMovement[]
  requests        SupplyRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("supplies")
}

model SupplyMovement {
  id          String   @id @default(cuid())
  supplyId    String
  supply      Supply   @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  type        String
  quantity    Float
  date        DateTime
  description String?
  createdAt   DateTime @default(now())

  @@map("supply_movements")
}

// ── Fornecedores ───────────────────────────────────────────────────────

model Vendor {
  id          String   @id @default(cuid())
  companyName String
  document    String?
  contactName String
  phone       String
  whatsapp    String?
  email       String
  city        String?
  state       String?
  description String?
  status      String   @default("pendente") // pendente | aprovado | bloqueado
  inviteCode  String   @unique
  categories  String[] @default([]) // o que vende (categorias de insumo); vazio = todas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users      User[]
  clients    VendorClient[]
  promotions Promotion[]
  requests   SupplyRequest[]

  @@map("vendors")
}

/// Vínculo produtor ↔ fornecedor, sempre criado pelo produtor (convite ou busca)
model VendorClient {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  muted     Boolean  @default(false) // produtor silenciou as ofertas deste fornecedor
  shareStock Boolean @default(true) // fornecedor vê os itens do estoque abaixo do mínimo
  createdAt DateTime @default(now())

  @@unique([vendorId, farmId])
  @@map("vendor_clients")
}

/// Pedido de orçamento do produtor a um fornecedor vinculado (geralmente de um item em falta)
model SupplyRequest {
  id         String    @id @default(cuid())
  farmId     String
  farm       Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  vendorId   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  supplyId   String?
  supply     Supply?   @relation(fields: [supplyId], references: [id], onDelete: SetNull)
  itemName   String
  category   String
  quantity   Float?
  unit       String?
  note       String?
  status     String    @default("novo") // novo | respondido | fechado | cancelado
  reply      String?
  replyPrice Float?
  repliedAt  DateTime?
  createdBy  String? // nome de quem pediu
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([vendorId, status])
  @@index([farmId, status])
  @@map("supply_requests")
}

model Promotion {
  id             String   @id @default(cuid())
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  category       String
  price          Float?
  unit           String?
  imageUrl       String?
  reach          String   @default("clientes") // clientes | regiao (clientes + produtores do mesmo estado)
  validUntil     DateTime
  isActive       Boolean  @default(true)
  whatsappClicks Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([vendorId])
  @@map("promotions")
}

// ── Anota Aí Leite (versão lite) ──────────────────────────────────────

/// Local onde o leite é anotado: um sítio ou um tanque comunitário.
/// Pertence a quem anota (produtor, motorista ou coletor).
model MilkPoint {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  kind      String   @default("sitio") // sitio | tanque
  active    Boolean  @default(true)
  /// Propriedade Pro ligada a este sítio da rota: o produtor vê as coletas do motorista
  farmId    String?
  farm      Farm?    @relation(fields: [farmId], references: [id], onDelete: SetNull)
  /// Ponto de coleta do laticínio (cadastrado por ele e visitado pelos motoristas das rotas)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactName    String? // responsável
  phone          String?
  address        String? // localização / como chegar
  tankLiters     Float? // capacidade do tanque
  accessNotes    String? // instruções de acesso (porteira, cachorro...)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries MilkEntry[]
  stops   RouteStop[]

  @@index([ownerId])
  @@index([farmId])
  @@index([organizationId])
  @@map("milk_points")
}

/// Litros anotados em um local num dia. Um valor por local por dia:
/// salvar de novo substitui, o que torna o reenvio offline seguro.
model MilkEntry {
  id        String    @id @default(cuid())
  pointId   String
  point     MilkPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  date      DateTime
  liters    Float
  /// Coleta do laticínio: observação, motivo de não ter coletado (litros 0), quem coletou e quando
  note          String?
  skipReason    String?
  collectedById String?
  collectedBy   User?     @relation("EntryCollector", fields: [collectedById], references: [id], onDelete: SetNull)
  collectedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([pointId, date])
  @@map("milk_entries")
}

/// Litros que a folha do motorista diz que ele levou, anotados pelo produtor para conferir com a própria anotação.
/// Do produtor do Anota Aí Leite (userId) ou da propriedade (farmId); um registro por dia de coleta.
model MilkSheet {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmId    String?
  farm      Farm?    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  date      DateTime
  liters    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@unique([farmId, date])
  @@map("milk_sheets")
}

// ── Laticínio e associação ─────────────────────────────────────────────

/// Conta de laticínio (organiza as coletas) ou associação (acompanha e apoia os associados).
/// Aprovada pelo admin, como o fornecedor.
model Organization {
  id          String   @id @default(cuid())
  type        String // laticinio | associacao
  name        String
  document    String?
  contactName String
  phone       String
  email       String
  city        String?
  state       String?
  status      String   @default("pendente") // pendente | aprovado | bloqueado
  inviteCode  String   @unique // associação: link para o produtor se associar
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users      User[]          @relation("OrgUsers")
  points     MilkPoint[]
  routes     Route[]
  receptions MilkReception[]
  members    OrgMember[]
  purchases  GroupPurchase[]
  notices    OrgNotice[]
  visits     TechVisit[]
  fees       MemberFee[]

  @@map("organizations")
}

/// Rota de coleta do laticínio: dias da semana, motorista e sequência das paradas
model Route {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  days           Int[]        @default([]) // 0 = domingo ... 6 = sábado
  driverId       String?
  driver         User?        @relation("RouteDriver", fields: [driverId], references: [id], onDelete: SetNull)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stops      RouteStop[]
  receptions MilkReception[]

  @@index([organizationId])
  @@index([driverId])
  @@map("routes")
}

model RouteStop {
  id       String    @id @default(cuid())
  routeId  String
  route    Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pointId  String
  point    MilkPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  position Int

  @@unique([routeId, pointId])
  @@map("route_stops")
}

/// Litros recebidos no laticínio (separado do coletado e do produzido, para conferir diferenças)
model MilkReception {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date           DateTime
  routeId        String?
  route          Route?       @relation(fields: [routeId], references: [id], onDelete: SetNull)
  liters         Float
  note           String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, date])
  @@map("milk_receptions")
}

/// Associado: propriedade (versão completa) ou produtor do Anota Aí Leite. O vínculo é feito pelo produtor.
model OrgMember {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmId          String?
  farm            Farm?        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String       @default("ativo") // ativo | inativo (definido pela associação)
  shareProduction Boolean      @default(true) // o produtor autoriza mostrar o total de leite
  createdAt       DateTime     @default(now())

  orders GroupPurchaseOrder[]
  visits TechVisit[]
  fees   MemberFee[]

  @@unique([organizationId, farmId])
  @@unique([organizationId, userId])
  @@map("org_members")
}

/// Comunicado da associação para os associados: reunião, curso, campanha de vacinação ou aviso
model OrgNotice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String       @default("aviso") // aviso | reuniao | curso | vacinacao
  title          String
  body           String?
  eventDate      DateTime? // data da reunião, curso ou campanha
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@map("org_notices")
}

/// Assistência técnica: o associado pede a visita (ou a associação agenda) e acompanha
model TechVisit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         OrgMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subject        String
  description    String?
  status         String       @default("solicitada") // solicitada | agendada | concluida | cancelada
  scheduledFor   DateTime?
  technician     String?
  result         String? // o que foi feito / orientação deixada
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@map("tech_visits")
}

/// Mensalidade do associado (uma por mês de referência)
model MemberFee {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         OrgMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reference      String // aaaa-mm
  amount         Float
  dueDate        DateTime
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([memberId, reference])
  @@index([organizationId, reference])
  @@map("member_fees")
}

/// Compra coletiva da associação: reúne os pedidos dos associados para negociar com fornecedores
model GroupPurchase {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  category       String
  unit           String
  description    String?
  deadline       DateTime?
  status         String       @default("aberta") // aberta | fechada
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders GroupPurchaseOrder[]

  @@index([organizationId])
  @@map("group_purchases")
}

model GroupPurchaseOrder {
  id         String        @id @default(cuid())
  purchaseId String
  purchase   GroupPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  memberId   String
  member     OrgMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  quantity   Float
  note       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([purchaseId, memberId])
  @@map("group_purchase_orders")
}
