# Adicione estas variáveis ao .env.local do servidor. Não use NEXT_PUBLIC_.
CONTACT_GMAIL_USER=anotaaiagro@gmail.com
# Senha de aplicativo do Google, nunca a senha normal da conta.
CONTACT_GMAIL_APP_PASSWORD=

# Suporte pelo WhatsApp: só números com DDD (o 55 entra sozinho). Fica só no servidor: a rota /api/suporte redireciona quem está logado.
# Sem a variável, a página Ajuda mostra só o e-mail.
SUPPORT_WHATSAPP=
